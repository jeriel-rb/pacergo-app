# Supabase — when these are set, @pacergo/api switches from mock data to live
# Supabase queries (see packages/api/src/supabase-client.ts: USE_MOCK).
# Leave unset for local mock-data development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical Web App origin used for auth email redirects.
# Must include http:// or https://.
# Production example: https://app.pacergo.app
# Local development example: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# NewebPay / 藍新金流 hosted checkout.
# Secrets are server-only. Do not prefix these with NEXT_PUBLIC_.
# Use newly rotated sandbox/live values; do not commit real credentials.
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_ENV=sandbox
# "simulated" skips NewebPay entirely (fake checkout); leave unset for the live provider.
PAYMENT_PROVIDER=simulated

# Key for application-layer encryption of sensitive fields (bank account numbers).
# Server-only — never prefix with NEXT_PUBLIC_, never commit a real value. Must be
# base64 of 16, 24 or 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes already-encrypted values unreadable, so back it
# up (password manager / host secrets) before saving any real bank details.
ENCRYPTION_KEY=

# Optional: key used to sign the password-recovery marker cookie. Falls back to
# SUPABASE_SERVICE_ROLE_KEY when unset. Any long random string works.
RECOVERY_COOKIE_SECRET=
