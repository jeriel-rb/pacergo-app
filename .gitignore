# dependencies
node_modules/

# yarn (berry, node-modules linker)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
yarn-error.log

# build output
dist/
*.tsbuildinfo

# local env files
.env
.env*.local

# Backend (Supabase) CLI link state. The real project lives in `backend/`.
# A local `supabase` symlink → `backend` is optional so the Supabase CLI
# (which hard-requires a folder named `supabase`) keeps working. No trailing
# slash: `supabase/` matches only a real directory, so the symlink stayed
# visible and `git add -A` died on paths beyond it.
backend/.temp/
/supabase

# local MCP server config (contains personal access tokens)
.mcp.json

# macOS
.DS_Store
