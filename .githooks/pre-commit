#!/bin/sh
# Catch the type errors that fail the Vercel build before they are committed.
# Skip in an emergency with: git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: typechecking @pacergo/shared and @pacergo/web…"
yarn workspace @pacergo/shared typecheck
yarn workspace @pacergo/web typecheck
